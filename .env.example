# --- operator / wallets ---
# Orchestrator/keeper read OPERATOR_PRIVATE_KEY. Deploy.s.sol reads DEPLOYER_PRIVATE_KEY + OPERATOR.
# DemoLocal.s.sol reads DEMO_PRIVATE_KEY (defaults to anvil key 0 when unset).
# Local default below is anvil key 0 (TEST FUNDS ONLY). For testnet, replace with a funded key — never commit it.
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OPERATOR_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OPERATOR=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
DEMO_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PROVIDER=0x000000000000000000000000000000000000CAFE
PROVIDER_PAYOUT=0x000000000000000000000000000000000000F00D
PROVIDER_PRICE=2000000
SERVICE_ID=haiku-v1

# --- provider endpoint (demo inference) ---
PROVIDER_ENDPOINT=https://provider.example/infer
PROVIDER_API_KEY=

# --- telegram bot ---
TELEGRAM_BOT_TOKEN=

# --- keeper (comma-separated borrower addresses to monitor for expiry) ---
