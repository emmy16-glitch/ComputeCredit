# =============================================================================
# ComputeCredit — environment template (spec ComputeCredit_v2.pdf §11.2, §14)
#
# Copy to `.env` and fill in. Never commit a filled `.env` (it is git-ignored).
# Nothing in this repository hardcodes endpoints, addresses, or prices:
# every value below is read at runtime (contracts/script, orchestrator/, bot/,
# dashboard/) and can also be supplied by a deployment record in
# `contracts/deployments/<chainId>.json`.
#
# The three MVP trust assumptions (spec §3.1) are not configuration — they are
# documented limitations. See README.md and docs/THREAT_MODEL.md.
# =============================================================================


# -----------------------------------------------------------------------------
# Network / chain
# -----------------------------------------------------------------------------
# X Layer testnet — confirmed against official docs on 2026-09-13:
#   https://web3.okx.com/onchainos/dev-docs/xlayer/developer/build-on-xlayer/network-information
#   chain id 1952, RPC https://testrpc.xlayer.tech/terigon, explorer
#   https://www.okx.com/web3/explorer/xlayer-test (settlement asset must be
#   configured: the official token table lists no testnet USDC).
# X Layer mainnet — chain id 196, RPC https://rpc.xlayer.tech
# Local demo — chain id 31337, RPC http://127.0.0.1:8545 (see docs/DEMO.md).
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
EXPLORER_BASE_URL=

# Settlement asset. Local demo uses the MockUSDC deployed by the demo script.
# X Layer mainnet USDC (official docs, verify again before deploying):
#   0x74b7F16337b8972027F6196A17a631aC6dE26d22
USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
USDC_DECIMALS=6


# -----------------------------------------------------------------------------
# Contract addresses
# Leave empty to load them from contracts/deployments/<CHAIN_ID>.json, which is
# written by `forge script script/Deploy.s.sol` / `script/DemoLocal.s.sol`.
# -----------------------------------------------------------------------------
VAULT_ADDRESS=
ROUTER_ADDRESS=
PASSPORT_ADDRESS=
REGISTRY_ADDRESS=
# Override the deployment record path (default: contracts/deployments/<chainId>.json)
# DEPLOYMENT_PATH=


# -----------------------------------------------------------------------------
# Wallets (demo keys only — never use funded production keys)
# -----------------------------------------------------------------------------
# Local demo keys are the public anvil defaults, listed for convenience only.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OPERATOR_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
LENDER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BORROWER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
BUYER_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a


# -----------------------------------------------------------------------------
# Demo / protocol parameters (spec §5, §9)
# -----------------------------------------------------------------------------
# Provider registry entry used by the demo (spec §11.2).
PROVIDER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
PROVIDER_WALLET=0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
PROVIDER_SERVICE_ID=haiku-v1
PROVIDER_PRICE_PER_JOB_USDC=0.02
PROVIDER_ENDPOINT=https://provider.example/infer
# Optional JSON file replacing the provider defaults above (spec §11.2)
# PROVIDER_CONFIG_PATH=orchestrator/providerRegistry.json

# Borrower / lender / buyer addresses used by the CLI and dashboard
BORROWER_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906
# Comma-separated borrower list for the dashboard (defaults to BORROWER_ADDRESS)
# BORROWERS=
# Bootstrap score seeded by the trusted attester at deploy time (spec §7.4)
BOOTSTRAP_SCORE=150
# Advance window in seconds — 43,200 = 12h (spec §5.1)
ADVANCE_WINDOW=43200
# Revenue split applied by the router — 2,000 = 20% of every routed payment (spec §5.7)
SPLIT_BPS=2000
MAX_ADVANCE_USDC=1.0
# Buyer payment used by `orchestrator index.ts pay` / the demo driver
BUYER_PAYMENT_USDC=0.10
# Keep the orchestrator read-only: it will stop before signing anything
DRY_RUN=0
# Deposit used by the demo deposit step
DEMO_DEPOSIT_USDC=50


# -----------------------------------------------------------------------------
# Telegram bot (spec §11.3) — optional, Recommended capability
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=


# -----------------------------------------------------------------------------
# Dashboard (spec §12) — optional, read-only
# -----------------------------------------------------------------------------
DASHBOARD_PORT=8787
DASHBOARD_HOST=0.0.0.0
DASHBOARD_REFRESH_MS=15000
# First block scanned for events; 0 scans from genesis (fine for a local chain)
DASHBOARD_FROM_BLOCK=0
# Explicit lender list for the dashboard (defaults to a plain deposit scan)
# DASHBOARD_LENDERS=
